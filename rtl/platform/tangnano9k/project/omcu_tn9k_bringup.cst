// OpenMCU Tang Nano 9K bring-up constraints.
// Pin assignments were cross-checked against Sipeed's public TangNano-9K
// picotiny project at c3b795799f23de91982be52db4273a8eea100cdb. They remain
// subject to a physical-board confirmation before a supported release.

IO_LOC "clk_27m_i" 52;
IO_PORT "clk_27m_i" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "resetn_i" 4;
IO_PORT "resetn_i" PULL_MODE=UP;

IO_LOC "uart_tx_o" 17;
IO_PORT "uart_tx_o" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "uart_rx_i" 18;
IO_PORT "uart_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "led_n_o[0]" 10;
IO_PORT "led_n_o[0]" PULL_MODE=UP DRIVE=8;
IO_LOC "led_n_o[1]" 11;
IO_PORT "led_n_o[1]" PULL_MODE=UP DRIVE=8;
IO_LOC "led_n_o[2]" 13;
IO_PORT "led_n_o[2]" PULL_MODE=UP DRIVE=8;
IO_LOC "led_n_o[3]" 14;
IO_PORT "led_n_o[3]" PULL_MODE=UP DRIVE=8;
IO_LOC "led_n_o[4]" 15;
IO_PORT "led_n_o[4]" PULL_MODE=UP DRIVE=8;
IO_LOC "led_n_o[5]" 16;
IO_PORT "led_n_o[5]" PULL_MODE=UP DRIVE=8;

// These assignments use the 3.3 V J5/TF-card signal group published in the
// Tang Nano 9K reference design.  They are covered by digital P&R and remain
// explicitly subject to the physical-board validation checklist in docs.
// SPI0 shares J5/TF-card signals: do not use a microSD card concurrently.
IO_LOC "spi0_cs_n_o" 38;
IO_PORT "spi0_cs_n_o" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "spi0_mosi_o" 37;
IO_PORT "spi0_mosi_o" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "spi0_sck_o" 36;
IO_PORT "spi0_sck_o" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "spi0_miso_i" 39;
IO_PORT "spi0_miso_i" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "pwm0_o" 25;
IO_PORT "pwm0_o" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "i2c0_scl_io" 26;
IO_PORT "i2c0_scl_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "i2c0_sda_io" 27;
IO_PORT "i2c0_sda_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio_io[0]" 28;
IO_PORT "gpio_io[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio_io[1]" 29;
IO_PORT "gpio_io[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio_io[2]" 30;
IO_PORT "gpio_io[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// J5 pins 11..19 are 3.3 V signals shared with the RGB-LCD connector.  They
// are intentionally exposed only through the explicit 12-pad GPIO profile;
// do not attach an RGB LCD and an external MCU device to the same net.  Their
// electrical behavior remains subject to the HIL matrix for the exact board
// revision, cable and external device.
IO_LOC "gpio_io[3]" 33;
IO_PORT "gpio_io[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio_io[4]" 34;
IO_PORT "gpio_io[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio_io[5]" 40;
IO_PORT "gpio_io[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio_io[6]" 35;
IO_PORT "gpio_io[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio_io[7]" 41;
IO_PORT "gpio_io[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio_io[8]" 42;
IO_PORT "gpio_io[8]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio_io[9]" 51;
IO_PORT "gpio_io[9]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio_io[10]" 53;
IO_PORT "gpio_io[10]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "gpio_io[11]" 54;
IO_PORT "gpio_io[11]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
