    { "name": "OMCU_SYSCTRL_ABI_MAJOR_MASK", "value": "UINT32_C(0xFFFF0000)" },
    { "name": "OMCU_SYSCTRL_ABI_MINOR_MASK", "value": "UINT32_C(0x0000FFFF)" }
  ],
  "peripherals": [
