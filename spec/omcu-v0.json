  "memory": [
    { "macro": "OMCU_ROM_BASE", "address": "0x00000000" },
    { "macro": "OMCU_SRAM_BASE", "address": "0x10000000" },
    { "macro": "OMCU_QSPI_XIP_BASE", "address": "0x20000000" },
    { "macro": "OMCU_GPIO0_BASE", "address": "0x40000000" },
    { "macro": "OMCU_UART0_BASE", "address": "0x40001000" },
    { "macro": "OMCU_TIMER0_BASE", "address": "0x40002000" },
    { "macro": "OMCU_SPI0_BASE", "address": "0x40003000" },
    { "macro": "OMCU_I2C0_BASE", "address": "0x40004000" },
    { "macro": "OMCU_WDT0_BASE", "address": "0x40005000" },
    { "macro": "OMCU_PWM0_BASE", "address": "0x40006000" },
