    { "name": "OMCU_WDT_CTRL_ENABLE", "value": "1u << 0" },
    { "name": "OMCU_WDT_CTRL_RESET_ENABLE", "value": "1u << 1" },
    { "name": "OMCU_WDT_CTRL_IRQ_ENABLE", "value": "1u << 2" },
