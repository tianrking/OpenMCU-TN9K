    { "name": "OMCU_WDT_FEED_MAGIC", "value": "UINT32_C(0x51F15EED)" },
    { "name": "OMCU_PWM_CTRL_ENABLE", "value": "1u << 0" },
    { "name": "OMCU_PWM_CTRL_INVERT", "value": "1u << 1" }
  ]
}
