        { "name": "chip_id", "offset": "0x00", "access": "ro", "comment": "OpenMCU chip identifier" },
        { "name": "abi", "offset": "0x04", "access": "ro", "comment": "major in bits 31:16, minor in bits 15:0" },
        { "name": "features", "offset": "0x08", "access": "ro", "comment": "implemented peripheral feature bits" },
        { "name": "build_id", "offset": "0x0c", "access": "ro", "comment": "platform build identifier" },
        { "name": "memory_kib", "offset": "0x10", "access": "ro", "comment": "SRAM KiB in bits 31:16, ROM KiB in bits 15:0" }
